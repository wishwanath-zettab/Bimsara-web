#!/bin/bash
set -euo pipefail

# ==============================================================================
# bweb-deploy — deploy Bimsara-web. Run this ON the VM (187.127.209.34).
#
# Syncs the repo at $APP_DIR (cloning it on first run), then rebuilds and
# restarts the Docker stack.
#
# Layout on the VM:
#   /opt/bimsara-web/bweb-deploy   this script
#   /opt/bimsara-web/repo          the git checkout ($APP_DIR)
#
# The script deliberately lives outside the checkout: the sync below runs
# `git clean -fd`, so anything inside $APP_DIR is disposable.
#
# Usage:
#   sudo /opt/bimsara-web/bweb-deploy
#
# Optional environment overrides:
#   APP_DIR         git checkout dir     (default: /opt/bimsara-web/repo)
#   BRANCH          branch to deploy     (default: main)
#   REPO_URL        clone URL, first run (default: this repo's origin)
#   BUILD_NO_CACHE  1 = --no-cache build (default: 1)
#   LOG_FILE        log path             (default: /var/log/bimsara-deploy.log)
#
# Example:
#   BUILD_NO_CACHE=0 sudo -E /opt/bimsara-web/bweb-deploy
# ==============================================================================

APP_DIR="${APP_DIR:-/opt/bimsara-web/repo}"
BRANCH="${BRANCH:-main}"
REPO_URL="${REPO_URL:-https://github.com/wishwanath-zettab/Bimsara-web.git}"
BUILD_NO_CACHE="${BUILD_NO_CACHE:-1}"
LOG_FILE="${LOG_FILE:-/var/log/bimsara-web-deploy.log}"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

fail() {
    log "ERROR: $*"
    exit 1
}

# Trap unexpected errors
trap 'fail "Script failed at line $LINENO. Check $LOG_FILE for details."' ERR

# --- Privilege check ---
# $APP_DIR and the docker socket normally require root.
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
else
    command -v sudo >/dev/null 2>&1 || fail "Not running as root and sudo is unavailable. Re-run with: sudo $0"
    SUDO="sudo"
    sudo -n true 2>/dev/null || fail "Root privileges required. Re-run with: sudo $0"
fi

# Make sure the log file is writable before the first log() call.
$SUDO touch "$LOG_FILE" 2>/dev/null || LOG_FILE=/tmp/bimsara-deploy.log
$SUDO chmod 644 "$LOG_FILE" 2>/dev/null || true

log "========== Deployment Started =========="

# --- Prerequisite checks ---
command -v git    >/dev/null 2>&1 || fail "git is not installed."
command -v docker >/dev/null 2>&1 || fail "docker is not installed."

$SUDO docker info >/dev/null 2>&1 \
    || fail "Docker daemon is not running. Start it with: sudo systemctl start docker"
$SUDO docker compose version >/dev/null 2>&1 \
    || fail "The 'docker compose' plugin is not available."

# --- Clone on first run ---
if [ ! -d "$APP_DIR/.git" ]; then
    if [ -d "$APP_DIR" ] && [ -n "$(ls -A "$APP_DIR" 2>/dev/null)" ]; then
        fail "$APP_DIR exists and is not empty, but is not a git repository. Move it aside and re-run."
    fi
    log "No repository at $APP_DIR — cloning $REPO_URL (branch $BRANCH)..."
    $SUDO mkdir -p "$(dirname "$APP_DIR")"
    $SUDO git clone --branch "$BRANCH" "$REPO_URL" "$APP_DIR" 2>&1 | tee -a "$LOG_FILE" \
        || fail "git clone failed. Check the URL and this machine's git credentials."
    log "Clone complete."
fi

# --- Validate app directory ---
[ -f "$APP_DIR/docker-compose.yml" ] || [ -f "$APP_DIR/compose.yml" ] \
    || fail "No docker-compose.yml found in $APP_DIR"

cd "$APP_DIR" || fail "Cannot cd into $APP_DIR"

# Git refuses to operate on a repo owned by another user unless it is trusted.
$SUDO git config --global --get-all safe.directory 2>/dev/null | grep -qx "$APP_DIR" \
    || $SUDO git config --global --add safe.directory "$APP_DIR"

REMOTE_URL=$($SUDO git config --get remote.origin.url)
REPO_NAME=$(basename -s .git "$REMOTE_URL")

log "Repo Name      : $REPO_NAME"
log "Remote URL     : $REMOTE_URL"
log "Branch         : $BRANCH"
log "Checkout dir   : $APP_DIR"
log "No-cache build : $BUILD_NO_CACHE"

# --- Git sync (force clean and pull fresh code) ---
log "Cleaning local repository and pulling fresh code..."

BEFORE_HASH=$($SUDO git rev-parse HEAD)

# Fetch latest from remote
$SUDO git fetch origin "$BRANCH" 2>&1 | tee -a "$LOG_FILE" \
    || fail "git fetch failed."

# Switch to the deploy branch (force, discarding any local edits)
$SUDO git checkout -f "$BRANCH" 2>&1 | tee -a "$LOG_FILE" \
    || fail "git checkout $BRANCH failed."

# Reset tracked files to remote branch
$SUDO git reset --hard "origin/$BRANCH" 2>&1 | tee -a "$LOG_FILE" \
    || fail "git reset failed."

# Remove untracked files/folders
$SUDO git clean -fd 2>&1 | tee -a "$LOG_FILE" \
    || fail "git clean failed."

AFTER_HASH=$($SUDO git rev-parse HEAD)

if [ "$BEFORE_HASH" = "$AFTER_HASH" ]; then
    log "Repository refreshed. No new commits (at ${AFTER_HASH:0:7})."
else
    log "Updated: ${BEFORE_HASH:0:7} -> ${AFTER_HASH:0:7}"
fi

# --- Retire the pre-rename stack ---
# docker-compose.yml now sets an explicit project name (bimsara-web). Before it
# did, the project was named after the checkout directory — "repo" — and that
# stack is invisible to every compose command below, including the `down`. Its
# container keeps the published port, so the renamed stack would fail to start
# with "address already in use". Harmless no-op once it is gone.
if [ -n "$($SUDO docker ps -aq --filter 'label=com.docker.compose.project=repo' 2>/dev/null)" ]; then
    log "Removing legacy 'repo' compose stack (superseded by 'bimsara-web')..."
    $SUDO docker compose -p repo down --remove-orphans 2>&1 | tee -a "$LOG_FILE" \
        || log "WARNING: could not remove the legacy stack; continuing."
fi

# --- Docker rebuild ---
log "Bringing down existing containers..."
$SUDO docker compose down 2>&1 | tee -a "$LOG_FILE" \
    || fail "docker compose down failed."

if [ "$BUILD_NO_CACHE" = "1" ]; then
    log "Building Docker image (no cache)..."
    $SUDO docker compose build --no-cache 2>&1 | tee -a "$LOG_FILE" \
        || fail "docker compose build failed."
else
    log "Building Docker image..."
    $SUDO docker compose build 2>&1 | tee -a "$LOG_FILE" \
        || fail "docker compose build failed."
fi

log "Starting containers..."
$SUDO docker compose up -d 2>&1 | tee -a "$LOG_FILE" \
    || fail "docker compose up failed."

# --- Health check ---
log "Waiting for containers to become healthy..."
sleep 5

RUNNING=$($SUDO docker compose ps --status running -q | wc -l)
if [ "$RUNNING" -eq 0 ]; then
    log "Container logs (last 50 lines):"
    $SUDO docker compose logs --tail=50 2>&1 | tee -a "$LOG_FILE"
    fail "No containers are running after startup. See logs above."
fi
log "$RUNNING container(s) running."

log "========== Deployment Complete =========="
log "Logs: $LOG_FILE"
