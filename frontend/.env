# REACT_APP_API_URL is intentionally NOT set.
#
# Unset, a production build uses relative URLs (see src/apiConfig.js), so the
# app talks to the origin it was served from — the same container serves the
# bundle and /api. Setting it hard-codes an absolute origin into the JS at
# BUILD time, which is how this ended up pointing at https://bimsara.com and
# making every www.bimsara.com visitor call the API cross-origin.
#
# Set it only when the API genuinely lives somewhere else, and rebuild the
# image afterwards — changing it without a rebuild has no effect.
#
#REACT_APP_API_URL=https://bimsara.com
#REACT_APP_API_URL=http://20.198.168.222
