JWT_SECRET=change-me-to-a-strong-random-secret
ADMIN_PASSWORD=admin

# Host port docker-compose publishes on all interfaces (the container always
# listens on 80). Must stay off 80/443, which the host nginx owns, and must
# match the proxy_pass target in nginx/bimsaraweb.conf (propertyweb-infra repo).
HTTP_HOST_PORT=8080
