JWT_SECRET=change-me-to-a-strong-random-secret
ADMIN_PASSWORD=admin

# Host ports docker-compose publishes on all interfaces. They map 1:1 to the
# container's PORT / HTTPS_PORT (8080/8443), so changing one of these means
# changing the matching value in docker-compose.yml too.
#
# Must stay off 80/443 — nginx owns those on the VM — and HTTPS_HOST_PORT must
# match the proxy_pass target in nginx/bimsaraweb.conf (propertyweb-infra repo).
HTTP_HOST_PORT=8080
HTTPS_HOST_PORT=8443
