JWT_SECRET=change-me-to-a-strong-random-secret
ADMIN_PASSWORD=admin

# Host port docker-compose publishes on all interfaces. It maps 1:1 to the
# container's PORT (8100), so changing it means changing PORT in
# docker-compose.yml too.
#
# Must stay off 80/443 — nginx owns those on the VM — must not collide with the
# 8081-8096 block propertyweb qa/prod reserve, and must match the proxy_pass
# target in nginx/bimsaraweb.conf (propertyweb-infra repo).
#
# The container speaks plain HTTP; nginx terminates TLS in front of it.
HTTP_HOST_PORT=8100
